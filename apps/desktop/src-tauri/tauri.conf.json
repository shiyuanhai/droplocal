{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DropLocal",
  "version": "1.3.0",
  "identifier": "app.droplocal.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DropLocal",
        "width": 720,
        "height": 620,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "DropLocal desktop app",
    "longDescription": "Drop it local. Pick it up anywhere.",
    "category": "Utility",
    "createUpdaterArtifacts": true,
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.icns",
      "../icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEQjE5QzVFOEQyNUREQkQKUldTOTNTV05YcHl4UGVqbkxuenhFK3ArQWpza09xZDRVTXFXWXBXOS9kZi9XU3AxeGtvTDFtV1UK",
      "endpoints": [
        "https://github.com/shiyuanhai/droplocal/releases/latest/download/latest.json"
      ]
    }
  }
}
