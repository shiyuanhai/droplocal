{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DropLocal",
  "version": "1.0.0",
  "identifier": "io.droplocal.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DropLocal Desktop",
        "width": 980,
        "height": 840,
        "minWidth": 760,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "DropLocal desktop app",
    "longDescription": "Drop it local. Pick it up anywhere.",
    "category": "Utility",
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.icns",
      "../icons/icon.ico"
    ]
  }
}
